# ── Upstage Solar API ─────────────────────────────────────────────────────
UPSTAGE_API_KEY=up_...

# ── Model selection (optional, defaults to solar-pro2) ────────────────────
# LLM_MODEL=solar-pro2

# ── Music dataset path (optional) ─────────────────────────────────────────
# Defaults to searching common locations. Override if needed:
# MUSIC_DATA_PATH=C:/Users/dbstk/OneDrive/바탕 화면/소마/final_dataset.csv

# ── LangSmith tracing ─────────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=music-recommendation-agent
